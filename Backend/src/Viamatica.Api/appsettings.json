{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5544;Database=viamatica;Username=viamatica;Password=viamatica_dev"
  },
  "Security": {
    "EncryptionKey": "dev-only-encryption-key-change-me",
    "JwtKey": "dev-only-jwt-signing-key-change-me-0123456789",
    "JwtIssuer": "viamatica-api",
    "JwtAudience": "viamatica-app",
    "JwtMinutes": 120
  },
  "Seed": {
    "Admin": {
      "Username": "admin001",
      "Password": "Admin1234",
      "Email": "admin@viamatica.local",
      "Identification": "0900000001"
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/viamatica-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
