# Copie este archivo como .env y complete los valores.
# Ambas funciones son opcionales: sin estos datos, el sistema funciona igual,
# pero sin envío de correos y sin el asistente.

# Recuperación de contraseña por correo (Gmail: use una contraseña de aplicación)
EMAIL_USER=
EMAIL_PASSWORD=

# Asistente con IA (clave de la API de Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
